# ---- Application ----------------------------------------------------------
APP_NAME=go-echo-template
APP_ENV=development          # development | production
APP_VERSION=dev

# ---- HTTP -----------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s    # grace period for in-flight requests
HTTP_BODY_LIMIT_BYTES=2097152
HTTP_ALLOWED_ORIGINS=*

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=debug              # trace|debug|info|warn|error|fatal|panic
LOG_FORMAT=console           # console (local) | json (deployed)

# ---- Database -------------------------------------------------------------
# DATABASE_URL takes precedence over the discrete DB_* values when set.
# DATABASE_URL=postgres://<user>:<password>@localhost:5432/app?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_AUTO_MIGRATE=true         # apply embedded migrations at startup
DB_MIGRATE_TIMEOUT=60s

# ---- Infisical ------------------------------------------------------------
# Off by default: the app then reads the plain env vars above.
# When on, secrets fetched from Infisical are injected into the environment
# before config is parsed, so any variable above can live in the vault instead.
INFISICAL_ENABLED=false
INFISICAL_SITE_URL=https://app.infisical.com   # self-hosted: https://infisical.example.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/
INFISICAL_RECURSIVE=true
INFISICAL_OVERRIDE=false     # true = vault wins over vars already in the env
INFISICAL_TIMEOUT=15s
INFISICAL_CACHE_TTL_SECONDS=0
